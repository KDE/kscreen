#: hdrcalibrator.cpp:136 Main.qml:16
#, kde-format
msgctxt "@title:window"
msgid "HDR Calibration"
msgstr "HDR kalibracija"

#: Main.qml:188 Main.qml:366
#, kde-format
msgctxt "@action:button"
msgid "Next"
msgstr "Sledeće"

#: Main.qml:195 Main.qml:372
#, kde-format
msgctxt "@info accessible description of a push button"
msgid "Switches to the next page"
msgstr "Prelazi na sledeću stranicu"

#: Main.qml:199 Main.qml:376 Main.qml:476
#, kde-format
msgctxt "@action:button"
msgid "Cancel"
msgstr "Odustani"

#: Main.qml:202 Main.qml:379 Main.qml:479
#, kde-format
msgctxt "@info accessible description of a push button"
msgid "Cancels the calibration process"
msgstr "Prekida postupak kalibracije"

#: Main.qml:211
#, kde-format
msgid ""
"To determine the maximum brightness of the screen, adjust the slider until "
"the logo is barely visible"
msgstr ""
"Da biste odredili najveći osvetljaj ekrana, pomerajte klizač dok logo ne "
"postane jedva vidljiv"

#: Main.qml:390
#, kde-format
msgid ""
"Configure how bright “100%” on the normal brightness slider should be. Make "
"it as bright as you'd ever use it, as long as the HDR image still looks good "
"and the gradients are smooth.\n"
"To avoid brightness fluctuations, it's recommended to not exceed the "
"display's maximum average brightness of %1cd/m²"
msgstr ""
"Podesite koliko svetlo treba da bude „100%“ na običnom klizaču osvetljaja. "
"Podesite ga na najveći osvetljaj koji biste ikada koristili, dok god HDR "
"slika i dalje izgleda dobro, a prelivi su glatki.\n"
"Da biste izbegli kolebanja osvetljaja, preporučuje se da ne prelazite "
"najveći prosečni osvetljaj ekrana od %1cd/m²"

#: Main.qml:392
#, kde-format
msgid ""
"Configure how bright “100%” on the normal brightness slider should be. Make "
"it as bright as you'd ever use it, as long as the HDR image still looks good "
"and the gradients are smooth."
msgstr ""
"Podesite koliko svetlo treba da bude „100%“ na običnom klizaču osvetljaja. "
"Podesite ga na najveći osvetljaj koji biste ikada koristili, dok god HDR "
"slika i dalje izgleda dobro, a prelivi su glatki."

#: Main.qml:439
#, kde-format
msgid "Maximum luminance: %1cd/m²"
msgstr "Najveća luminansa: %1cd/m²"

#: Main.qml:460
#, kde-format
msgid "Reference luminance / paper white: %1cd/m²"
msgstr "Referentna luminansa / belina papira: %1cd/m²"

#: Main.qml:471
#, kde-format
msgctxt "@action:checkbox"
msgid "Assume Windows HDR applications are calibrated for this screen"
msgstr "Pretpostavi da su windows HDR programi kalibrisani za ovaj ekran"

#: Main.qml:483
#, kde-format
msgctxt "@action:button"
msgid "Done"
msgstr "Gotovo"

#: Main.qml:492
#, kde-format
msgctxt "@info accessible description of a push button"
msgid "Finish the calibration process"
msgstr "Završi postupak kalibracije"

#: Main.qml:501
#, kde-format
msgid ""
"Many Windows applications come with their own calibration settings, which "
"this system wide configuration conflicts with. If this option is set, their "
"calibration settings will work as expected on this specific display."
msgstr ""
"Mnogi programi za Windows imaju sopstvene postavke kalibracije, sa kojima se "
"ova sistemska postava sukobljava. Ako je ova opcija uključena, njihove "
"postavke kalibracije radiće kako se očekuje na ovom ekranu."
